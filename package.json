{
  "name": "assertledger",
  "version": "1.0.0",
  "description": "Verify that regression tests detect a declared bug, with deterministic verdicts and replayable evidence.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@11.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoklims/assertledger.git"
  },
  "homepage": "https://github.com/hoklims/assertledger#readme",
  "bugs": {
    "url": "https://github.com/hoklims/assertledger/issues"
  },
  "bin": {
    "assertledger": "dist/cli.js",
    "testforge": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "benchmarks",
    "conformance",
    "schemas",
    "integrations",
    "README.md",
    "README.fr.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "!benchmarks/agentic-profile/private",
    "!benchmarks/**/RESULT-*.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run check:schemas && pnpm run check:conformance && pnpm run typecheck && pnpm run test",
    "smoke:package": "pnpm run build && pnpm run check:schemas && pnpm run check:conformance && tsx scripts/smoke-package.ts",
    "check:conformance": "tsx scripts/check-conformance-v1.ts",
    "witness:conformance": "tsx scripts/run-conformance-negative-witnesses.ts",
    "check:schemas": "tsx scripts/check-schemas.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "pretest:coverage": "pnpm run build",
    "test:coverage": "tsx --test --test-concurrency=2 --experimental-test-coverage tests/*.test.ts",
    "prepack": "pnpm run build && pnpm run check:schemas"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.1",
    "tsx": "4.23.5"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "keywords": [],
  "author": ""
}
