{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "repository": {
      "$ref": "#/$defs/__schema1"
    },
    "adapter": {
      "$ref": "#/$defs/__schema3"
    },
    "isolation": {
      "$ref": "#/$defs/__schema8"
    },
    "candidateRoots": {
      "$ref": "#/$defs/__schema11"
    },
    "budgets": {
      "$ref": "#/$defs/__schema13"
    },
    "policy": {
      "$ref": "#/$defs/__schema14"
    },
    "worlds": {
      "$ref": "#/$defs/__schema16"
    },
    "candidates": {
      "$ref": "#/$defs/__schema20"
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "adapter",
    "isolation",
    "candidateRoots",
    "budgets",
    "policy",
    "worlds",
    "candidates"
  ],
  "additionalProperties": false,
  "title": "AssertLedger verification request v3",
  "description": "A versioned campaign with an official Bun test adapter and explicit execution backend.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "3.0.0"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "exclude": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": ["root", "exclude"],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema3": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "node-test"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "baseTestFiles": {
              "minItems": 1,
              "maxItems": 1000,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema4"
              }
            },
            "extraArguments": {
              "maxItems": 0,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema5"
              }
            }
          },
          "required": ["kind", "executable", "baseTestFiles"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "testforge-command"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema6"
              }
            },
            "protocolVersion": {
              "type": "string",
              "const": "1.0.0"
            }
          },
          "required": ["kind", "executable", "arguments", "protocolVersion"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bun-test"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "baseTestFiles": {
              "minItems": 1,
              "maxItems": 1000,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema7"
              }
            }
          },
          "required": ["kind", "executable", "baseTestFiles"],
          "additionalProperties": false
        }
      ]
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "__schema5": {
      "type": "string"
    },
    "__schema6": {
      "type": "string"
    },
    "__schema7": {
      "type": "string",
      "minLength": 1
    },
    "__schema8": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "trusted-local"
            },
            "acknowledgedUnsafeExecution": {
              "type": "boolean"
            },
            "environmentAllowlist": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema9"
              }
            }
          },
          "required": ["kind", "acknowledgedUnsafeExecution", "environmentAllowlist"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "container"
            },
            "image": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]{1,5})?\\/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:\\/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?@sha256:[a-f0-9]{64}$"
            },
            "environment": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema10"
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memoryBytes": {
                  "type": "integer",
                  "minimum": 67108864,
                  "maximum": 68719476736
                },
                "cpuMillicores": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 256000
                },
                "pids": {
                  "type": "integer",
                  "minimum": 16,
                  "maximum": 65536
                },
                "temporaryDirectoryBytes": {
                  "type": "integer",
                  "minimum": 1048576,
                  "maximum": 17179869184
                }
              },
              "required": ["memoryBytes", "cpuMillicores", "pids", "temporaryDirectoryBytes"],
              "additionalProperties": false
            }
          },
          "required": ["kind", "image", "environment", "limits"],
          "additionalProperties": false
        }
      ]
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:[Nn][Oo][Dd][Ee]_[Oo][Pp][Tt][Ii][Oo][Nn][Ss]$|[Tt][Ee][Ss][Tt][Ff][Oo][Rr][Gg][Ee]_|[Nn][Oo][Dd][Ee]_[Tt][Ee][Ss][Tt]_)).+$"
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/__schema9"
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": ["name", "value"],
      "additionalProperties": false
    },
    "__schema11": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema12"
      }
    },
    "__schema12": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "maximumCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maximumWorlds": {
          "type": "integer",
          "minimum": 3,
          "maximum": 1000
        },
        "maximumExecutions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maximumRepositoryFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maximumRepositoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "maximumWorldOverlayBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "maximumCandidateBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maximumTotalCandidateBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000000
        },
        "timeoutMsPerExecution": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400000
        },
        "maximumOutputBytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 100000000
        }
      },
      "required": [
        "maximumCandidates",
        "maximumWorlds",
        "maximumExecutions",
        "maximumRepositoryFiles",
        "maximumRepositoryBytes",
        "maximumWorldOverlayBytes",
        "maximumCandidateBytes",
        "maximumTotalCandidateBytes",
        "timeoutMsPerExecution",
        "maximumOutputBytes"
      ],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "policyVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "requiredAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "minimumTargetWeightPermille": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maximumSelectedCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "acceptedTargetOutcomes": {
          "minItems": 1,
          "maxItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema15"
          }
        }
      },
      "required": [
        "policyVersion",
        "requiredAttempts",
        "minimumTargetWeightPermille",
        "maximumSelectedCandidates",
        "acceptedTargetOutcomes"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "string",
      "const": "ASSERTION_FAILURE"
    },
    "__schema16": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema17"
      }
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema18"
        },
        "kind": {
          "type": "string",
          "enum": ["REFERENCE", "TARGET", "NEUTRAL"]
        },
        "required": {
          "type": "boolean"
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "files": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema19"
          }
        }
      },
      "required": ["id", "kind", "required", "weight", "provenance", "files"],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "__schema19": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "required": ["path", "content"],
      "additionalProperties": false
    },
    "__schema20": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema21"
      }
    },
    "__schema21": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema18"
        },
        "files": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema19"
          }
        }
      },
      "required": ["id", "files"],
      "additionalProperties": false
    }
  },
  "$id": "https://testforge.dev/schemas/verification-request.v3.json"
}
