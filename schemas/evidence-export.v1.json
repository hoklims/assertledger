{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceManifest": {
      "$ref": "#/$defs/__schema1"
    },
    "sourceArtifactDigest": {
      "$ref": "#/$defs/__schema2"
    },
    "consumerRequest": {
      "$ref": "#/$defs/__schema12"
    },
    "result": {
      "$ref": "#/$defs/__schema14"
    },
    "integrity": {
      "$ref": "#/$defs/__schema16"
    },
    "authenticity": {
      "$ref": "#/$defs/__schema17"
    },
    "environment": {
      "$ref": "#/$defs/__schema18"
    },
    "confidence": {
      "$ref": "#/$defs/__schema20"
    },
    "scope": {
      "$ref": "#/$defs/__schema21"
    },
    "controls": {
      "$ref": "#/$defs/__schema23"
    },
    "profile": {
      "$ref": "#/$defs/__schema24"
    },
    "policy": {
      "$ref": "#/$defs/__schema25"
    },
    "cost": {
      "$ref": "#/$defs/__schema26"
    },
    "limitations": {
      "$ref": "#/$defs/__schema27"
    },
    "exportDigest": {
      "$ref": "#/$defs/__schema2"
    }
  },
  "required": [
    "schemaVersion",
    "sourceManifest",
    "sourceArtifactDigest",
    "consumerRequest",
    "result",
    "integrity",
    "authenticity",
    "environment",
    "confidence",
    "scope",
    "controls",
    "profile",
    "policy",
    "cost",
    "limitations",
    "exportDigest"
  ],
  "additionalProperties": false,
  "title": "AssertLedger evidence export",
  "description": "A self-contained, replayable projection of replay-valid evidence that separates result, integrity, authenticity, environment, confidence, controls, and cost.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "repositoryDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "string",
              "const": "invalid"
            }
          ]
        },
        "evidenceContext": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": ["name", "version"],
              "additionalProperties": false
            },
            "adapter": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "configuration": {
                  "$ref": "#/$defs/__schema3"
                }
              },
              "required": ["name", "version", "configuration"],
              "additionalProperties": false
            },
            "execution": {
              "type": "object",
              "properties": {
                "isolation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "environmentAllowlist": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema4"
                  }
                },
                "budgets": {
                  "$ref": "#/$defs/__schema5"
                },
                "candidateRoots": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema6"
                  }
                }
              },
              "required": ["isolation", "environmentAllowlist", "budgets", "candidateRoots"],
              "additionalProperties": false
            },
            "worlds": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/$defs/__schema7"
                  },
                  "provenance": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "digest": {
                    "$ref": "#/$defs/__schema2"
                  }
                },
                "required": ["id", "provenance", "digest"],
                "additionalProperties": false
              }
            }
          },
          "required": ["engine", "adapter", "execution", "worlds"],
          "additionalProperties": false
        },
        "policy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "policyVersion": {
                  "type": "string",
                  "const": "1.0.0"
                },
                "requiredAttempts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "minimumTargetWeightPermille": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "maximumSelectedCandidates": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "acceptedTargetOutcomes": {
                  "minItems": 1,
                  "maxItems": 1,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema8"
                  }
                }
              },
              "required": [
                "policyVersion",
                "requiredAttempts",
                "minimumTargetWeightPermille",
                "maximumSelectedCandidates",
                "acceptedTargetOutcomes"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "policyVersion": {
                  "type": "string",
                  "const": "invalid"
                },
                "requiredAttempts": {
                  "type": "number",
                  "const": 1
                },
                "minimumTargetWeightPermille": {
                  "type": "number",
                  "const": 1000
                },
                "maximumSelectedCandidates": {
                  "type": "number",
                  "const": 0
                },
                "acceptedTargetOutcomes": {
                  "maxItems": 0,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema9"
                  }
                }
              },
              "required": [
                "policyVersion",
                "requiredAttempts",
                "minimumTargetWeightPermille",
                "maximumSelectedCandidates",
                "acceptedTargetOutcomes"
              ],
              "additionalProperties": false
            }
          ]
        },
        "worlds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema7"
              },
              "kind": {
                "type": "string",
                "enum": ["REFERENCE", "TARGET", "NEUTRAL"]
              },
              "required": {
                "type": "boolean"
              },
              "weight": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": ["id", "kind", "required", "weight"],
            "additionalProperties": false
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema7"
              },
              "digest": {
                "$ref": "#/$defs/__schema2"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "status": {
                "type": "string",
                "enum": ["ELIGIBLE", "UNSTABLE", "INCONCLUSIVE", "INVALID", "WEAK_ORACLE"]
              },
              "killedTargetIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema7"
                }
              },
              "targetWeightKilled": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "gates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/__schema10"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["PASSED", "FAILED", "NOT_RUN"]
                    },
                    "evidenceRunIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    },
                    "reasonCodes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/__schema11"
                      }
                    }
                  },
                  "required": ["name", "status", "evidenceRunIds", "reasonCodes"],
                  "additionalProperties": false
                }
              },
              "reasonCodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema11"
                }
              }
            },
            "required": [
              "id",
              "digest",
              "sizeBytes",
              "status",
              "killedTargetIds",
              "targetWeightKilled",
              "gates",
              "reasonCodes"
            ],
            "additionalProperties": false
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "candidateId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/__schema7"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "worldId": {
                "$ref": "#/$defs/__schema7"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "PASS",
                  "ASSERTION_FAILURE",
                  "COLLECTION_FAILURE",
                  "COMPILE_FAILURE",
                  "PROCESS_CRASH",
                  "TIMEOUT",
                  "INFRA_ERROR",
                  "NO_TEST_DISCOVERED"
                ]
              },
              "testsDiscovered": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "candidateTestsDiscovered": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "attributed": {
                "type": "boolean"
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              },
              "exitCode": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stdoutDigest": {
                "$ref": "#/$defs/__schema2"
              },
              "stderrDigest": {
                "$ref": "#/$defs/__schema2"
              }
            },
            "required": [
              "runId",
              "candidateId",
              "worldId",
              "attempt",
              "outcome",
              "testsDiscovered",
              "candidateTestsDiscovered",
              "attributed"
            ],
            "additionalProperties": false
          }
        },
        "decision": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["VERIFIED", "REJECTED", "INCONCLUSIVE", "ENGINE_ERROR"]
            },
            "selectedCandidateIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema7"
              }
            },
            "reasonCodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema11"
              }
            }
          },
          "required": ["status", "selectedCandidateIds", "reasonCodes"],
          "additionalProperties": false
        },
        "decisionDigest": {
          "$ref": "#/$defs/__schema2"
        },
        "artifactDigest": {
          "$ref": "#/$defs/__schema2"
        },
        "adapter": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "node-test"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "testforge-command"
                },
                "protocolVersion": {
                  "type": "string",
                  "const": "1.0.0"
                }
              },
              "required": ["kind", "protocolVersion"],
              "additionalProperties": false
            }
          ]
        },
        "isolation": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "trusted-local"
            },
            "level": {
              "type": "string",
              "const": "UNSANDBOXED"
            },
            "acknowledgedUnsafeExecution": {
              "type": "boolean",
              "const": true
            }
          },
          "required": ["kind", "level", "acknowledgedUnsafeExecution"],
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "required": [
        "schemaVersion",
        "repositoryDigest",
        "evidenceContext",
        "policy",
        "worlds",
        "candidates",
        "observations",
        "decision",
        "decisionDigest",
        "artifactDigest",
        "adapter",
        "isolation",
        "limitations"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema3"
          }
        }
      ]
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema5": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema5"
          }
        }
      ]
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema7": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "__schema8": {
      "type": "string",
      "const": "ASSERTION_FAILURE"
    },
    "__schema9": {
      "type": "string",
      "const": "ASSERTION_FAILURE"
    },
    "__schema10": {
      "type": "string",
      "enum": ["COMPLETENESS", "STABILITY", "DISCOVERY", "REFERENCE", "NEUTRAL", "TARGET_STRENGTH"]
    },
    "__schema11": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "__schema12": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "profileId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "obligations": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema13"
              }
            }
          },
          "required": ["reference", "profileId", "obligations"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema7"
        },
        "control": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": ["id", "control"],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "detection": {
          "type": "string",
          "enum": ["OBSERVED", "NOT_OBSERVED", "NOT_ESTABLISHED"]
        },
        "modality": {
          "type": "string",
          "enum": ["TEST_OBSERVED", "NONE"]
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "REGRESSION_ASSERTION_OBSERVED",
            "TARGET_PASSED_WITHOUT_DETECTION",
            "ENGINE_ERROR",
            "CONTROL_EVIDENCE_INVALID",
            "CANDIDATE_EVIDENCE_INCONCLUSIVE",
            "CANDIDATE_EVIDENCE_INVALID",
            "TARGET_STRENGTH_INSUFFICIENT",
            "OPERATIONAL_OUTCOME_NOT_DETECTION"
          ]
        },
        "decision": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["VERIFIED", "REJECTED", "INCONCLUSIVE", "ENGINE_ERROR"]
            },
            "selectedCandidateIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema7"
              }
            },
            "reasonCodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema11"
              }
            }
          },
          "required": ["status", "selectedCandidateIds", "reasonCodes"],
          "additionalProperties": false
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema7"
              },
              "digest": {
                "$ref": "#/$defs/__schema2"
              },
              "status": {
                "type": "string",
                "enum": ["ELIGIBLE", "UNSTABLE", "INCONCLUSIVE", "INVALID", "WEAK_ORACLE"]
              },
              "selected": {
                "type": "boolean"
              },
              "reasonCodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema11"
                }
              },
              "worlds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "worldId": {
                      "$ref": "#/$defs/__schema7"
                    },
                    "kind": {
                      "$ref": "#/$defs/__schema15"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "PASS",
                        "ASSERTION_FAILURE",
                        "COLLECTION_FAILURE",
                        "COMPILE_FAILURE",
                        "PROCESS_CRASH",
                        "TIMEOUT",
                        "INFRA_ERROR",
                        "NO_TEST_DISCOVERED",
                        "DIVERGENT",
                        "MISSING"
                      ]
                    },
                    "attempts": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "signal": {
                      "type": "string",
                      "enum": ["RED", "GREEN", "NONE"]
                    },
                    "detection": {
                      "type": "string",
                      "enum": ["OBSERVED", "NOT_OBSERVED", "NOT_ESTABLISHED", "NOT_APPLICABLE"]
                    }
                  },
                  "required": [
                    "worldId",
                    "kind",
                    "required",
                    "weight",
                    "outcome",
                    "attempts",
                    "signal",
                    "detection"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": ["id", "digest", "status", "selected", "reasonCodes", "worlds"],
            "additionalProperties": false
          }
        }
      },
      "required": ["detection", "modality", "reasonCode", "decision", "candidates"],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "string",
      "enum": ["REFERENCE", "TARGET", "NEUTRAL"]
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "sourceReplay": {
          "type": "string",
          "const": "VALID"
        },
        "verifiedRails": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "SCHEMA"
            },
            {
              "type": "string",
              "const": "DECISION_DIGEST"
            },
            {
              "type": "string",
              "const": "ARTIFACT_DIGEST"
            },
            {
              "type": "string",
              "const": "DECISION_SEMANTICS"
            }
          ]
        },
        "bindings": {
          "type": "object",
          "properties": {
            "artifactDigest": {
              "$ref": "#/$defs/__schema2"
            },
            "decisionDigest": {
              "$ref": "#/$defs/__schema2"
            },
            "repositoryDigest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema2"
                },
                {
                  "type": "string",
                  "const": "invalid"
                }
              ]
            },
            "policyDigest": {
              "$ref": "#/$defs/__schema2"
            },
            "worldDigests": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "worldId": {
                    "$ref": "#/$defs/__schema7"
                  },
                  "digest": {
                    "$ref": "#/$defs/__schema2"
                  }
                },
                "required": ["worldId", "digest"],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "artifactDigest",
            "decisionDigest",
            "repositoryDigest",
            "policyDigest",
            "worldDigests"
          ],
          "additionalProperties": false
        }
      },
      "required": ["sourceReplay", "verifiedRails", "bindings"],
      "additionalProperties": false
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "UNAUTHENTICATED"
        },
        "attestation": {
          "type": "string",
          "const": "NONE"
        },
        "declaredProducer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        }
      },
      "required": ["status", "attestation", "declaredProducer"],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "isolation": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "trusted-local"
            },
            "level": {
              "type": "string",
              "const": "UNSANDBOXED"
            }
          },
          "required": ["kind", "level"],
          "additionalProperties": false
        },
        "environmentAllowlist": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema19"
          }
        },
        "adapter": {
          "type": "object",
          "properties": {
