{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "provenance": {
      "$ref": "#/$defs/__schema1"
    },
    "repository": {
      "$ref": "#/$defs/__schema2"
    },
    "adapter": {
      "$ref": "#/$defs/__schema4"
    },
    "test": {
      "$ref": "#/$defs/__schema5"
    },
    "expectedFailure": {
      "$ref": "#/$defs/__schema7"
    },
    "targets": {
      "$ref": "#/$defs/__schema8"
    },
    "neutral": {
      "$ref": "#/$defs/__schema10"
    },
    "requiredAttempts": {
      "$ref": "#/$defs/__schema12"
    },
    "timeoutMsPerExecution": {
      "$ref": "#/$defs/__schema13"
    }
  },
  "required": [
    "schemaVersion",
    "provenance",
    "repository",
    "adapter",
    "test",
    "expectedFailure",
    "targets",
    "neutral",
    "requiredAttempts",
    "timeoutMsPerExecution"
  ],
  "additionalProperties": false,
  "title": "AssertLedger witness import request",
  "description": "A recorded red/green witness to replay: mutated targets, one designated test and its expected failure line.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "exclude": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        },
        "includeDependencies": {
          "type": "boolean"
        },
        "git": {
          "type": "string",
          "enum": ["excluded", "synthesized"]
        }
      },
      "required": ["root", "exclude", "includeDependencies", "git"],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "bun-test-designated"
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "testTimeoutMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["kind", "executable", "testTimeoutMs"],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "path": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        }
      },
      "required": ["file", "path"],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "__schema7": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "__schema8": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "beforeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "required": ["path", "beforeDigest", "content"],
      "additionalProperties": false
    },
    "__schema10": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "files": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema11"
              }
            }
          },
          "required": ["reason", "files"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "required": ["path", "content"],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "integer",
      "minimum": 2,
      "maximum": 10
    },
    "__schema13": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000
    }
  },
  "$id": "https://testforge.dev/schemas/witness-import-request.v1.json"
}
