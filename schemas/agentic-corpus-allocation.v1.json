{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "allocationId": {
      "$ref": "#/$defs/__schema0"
    },
    "algorithm": {
      "type": "string",
      "const": "SHA256_ASCENDING_SPLIT_V1"
    },
    "seedDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "calibrationCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999
    },
    "sourceCaseIds": {
      "minItems": 2,
      "maxItems": 100000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "strata": {
      "minItems": 1,
      "maxItems": 100000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "calibrationCaseIds": {
      "minItems": 1,
      "maxItems": 99999,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "holdoutCaseIds": {
      "minItems": 1,
      "maxItems": 99999,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "assignments": {
      "minItems": 2,
      "maxItems": 100000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "allocationDigest": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "schemaVersion",
    "allocationId",
    "algorithm",
    "seedDigest",
    "calibrationCount",
    "sourceCaseIds",
    "strata",
    "calibrationCaseIds",
    "holdoutCaseIds",
    "assignments",
    "allocationDigest"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceIdentityDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "calibrationCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999
        },
        "sourceCaseIds": {
          "minItems": 2,
          "maxItems": 100000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "calibrationCaseIds": {
          "minItems": 1,
          "maxItems": 99999,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "holdoutCaseIds": {
          "minItems": 1,
          "maxItems": 99999,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "sourceId",
        "sourceIdentityDigest",
        "calibrationCount",
        "sourceCaseIds",
        "calibrationCaseIds",
        "holdoutCaseIds"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "caseId": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceId": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceIdentityDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "scoreDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "partition": {
          "type": "string",
          "enum": ["CALIBRATION", "HOLDOUT"]
        }
      },
      "required": ["caseId", "sourceId", "sourceIdentityDigest", "scoreDigest", "partition"],
      "additionalProperties": false
    }
  },
  "$id": "https://testforge.dev/schemas/agentic-corpus-allocation.v1.json"
}
