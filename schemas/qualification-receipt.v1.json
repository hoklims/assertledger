{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "subject": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "baseCommit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "candidateDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": ["commit", "baseCommit", "candidateDigest", "inputDigest"],
          "additionalProperties": false
        },
        "ciTrust": {
          "type": "object",
          "properties": {
            "repositoryId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "observerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "publicKeyPem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "requiredSteps": {
              "minItems": 1,
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                  },
                  "commandDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": ["id", "commandDigest"],
                "additionalProperties": false
              }
            }
          },
          "required": ["repositoryId", "observerId", "publicKeyPem", "requiredSteps"],
          "additionalProperties": false
        },
        "tools": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "identityPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "versionCommand": {
                "type": "object",
                "properties": {
                  "executable": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "arguments": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 8192
                    }
                  }
                },
                "required": ["executable", "arguments"],
                "additionalProperties": false
              }
            },
            "required": ["id", "version", "digest"],
            "additionalProperties": false
          }
        },
        "suites": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "files": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "extraction": {
                "type": "string",
                "enum": ["COMPLETE", "UNAVAILABLE", "OMITTED"]
              }
            },
            "required": ["id", "files", "extraction"],
            "additionalProperties": false
          }
        },
        "obligations": {
          "minItems": 1,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "tests",
                  "selection",
                  "cache",
                  "propagation",
                  "wrapper",
                  "ci-config",
                  "ci-local",
                  "ci-live"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "suiteIds": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                }
              },
              "checks": {
                "minItems": 1,
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                    },
                    "actionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                    },
                    "field": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "expected": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  "required": ["id", "actionId", "field", "expected"],
                  "additionalProperties": false
                }
              },
              "limits": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            },
            "required": ["id", "kind", "required", "suiteIds", "checks", "limits"],
            "additionalProperties": false
          }
        },
        "actions": {
          "minItems": 1,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "adapter": {
                "type": "string",
                "enum": ["command", "turbo", "node-test", "bun-native", "ci-config"]
              },
              "executable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "arguments": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 8192
                }
              },
              "environment": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 8192
                }
              },
              "prepareFiles": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "content": {
                      "type": "string",
                      "maxLength": 1048576
                    }
                  },
                  "required": ["path", "content"],
                  "additionalProperties": false
                }
              },
              "removePaths": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "observe": {
                "type": "object",
                "properties": {
                  "trace": {
                    "type": "boolean"
                  },
                  "outputs": {
                    "maxItems": 1000,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  },
                  "report": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["trace", "outputs", "report"],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "adapter",
              "executable",
              "arguments",
              "environment",
              "prepareFiles",
              "removePaths",
              "observe"
            ],
            "additionalProperties": false
          }
        },
        "worlds": {
          "minItems": 2,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "kind": {
                "type": "string",
                "enum": ["REFERENCE", "TARGET", "NEUTRAL"]
              },
              "files": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "content": {
                      "type": "string",
                      "maxLength": 1048576
                    }
                  },
                  "required": ["path", "content"],
                  "additionalProperties": false
                }
              },
              "discriminants": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "obligationId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                    },
                    "checkIds": {
                      "minItems": 1,
                      "maxItems": 1000,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                      }
                    }
                  },
                  "required": ["obligationId", "checkIds"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["id", "kind", "files", "discriminants"],
            "additionalProperties": false
          }
        },
        "requiredAttempts": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "maximumOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "isolation": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "trusted-local"
            },
            "acknowledgedUnsafeExecution": {
              "type": "boolean",
              "const": true
            }
          },
          "required": ["kind", "acknowledgedUnsafeExecution"],
          "additionalProperties": false
        },
        "allowedCandidatePaths": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "required": [
        "schemaVersion",
        "profileId",
        "subject",
        "tools",
        "suites",
        "obligations",
        "actions",
        "worlds",
        "requiredAttempts",
        "timeoutMs",
        "maximumOutputBytes",
        "isolation",
        "allowedCandidatePaths"
      ],
      "additionalProperties": false
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidateDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "worldId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "actionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "state": {
            "type": "string",
            "enum": ["COMPLETED", "TIMEOUT", "CRASH", "INFRA_ERROR", "COLLECTION_ERROR", "NO_TESTS"]
          },
          "facts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "bindingDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": ["worldId", "attempt", "actionId", "state", "facts", "bindingDigest"],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "engineVersion": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime": {
          "type": "object",
          "properties": {
            "mechanismDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "platform": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "architecture": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "node": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$"
            },
            "tools": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "executable": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "identityPath": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "versionArguments": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 8192
                    }
                  }
                },
                "required": ["executable", "identityPath", "digest", "version", "versionArguments"],
                "additionalProperties": false
              }
            },
            "collectorDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "snapshotExcludes": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "const": ".git"
                },
                {
                  "type": "string",
                  "const": ".testforge"
                },
                {
                  "type": "string",
                  "const": ".turbo"
                },
                {
                  "type": "string",
                  "const": "coverage"
                },
                {
                  "type": "string",
                  "const": "node_modules"
                }
              ]
            },
            "dependencySnapshot": {
              "type": "string",
              "const": "EXCLUDED_NODE_MODULES"
            }
          },
          "required": [
            "mechanismDigest",
            "platform",
            "architecture",
            "node",
            "tools",
            "collectorDigest",
            "snapshotExcludes",
            "dependencySnapshot"
          ],
          "additionalProperties": false
        },
        "executionTrust": {
          "type": "string",
          "const": "TRUSTED_LOCAL_UNSANDBOXED"
        }
      },
      "required": ["engineVersion", "adapterVersions", "runtime", "executionTrust"],
      "additionalProperties": false
    },
    "externalCi": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "obligationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["COVERED", "OPEN", "REJECTED"]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mismatchCheckIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        },
        "required": ["obligationId", "kind", "required", "status", "reasons", "mismatchCheckIds"],
        "additionalProperties": false
      }
    },
    "coveredGuaranteeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "openGuaranteeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "decision": {
      "type": "string",
      "enum": ["QUALIFIED", "OPEN", "REJECTED"]
    },
    "decisionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "plan",
    "planDigest",
    "candidateDigest",
    "observations",
    "provenance",
    "externalCi",
    "assessments",
    "coveredGuaranteeIds",
    "openGuaranteeIds",
    "decision",
    "decisionDigest",
    "artifactDigest"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://testforge.dev/schemas/qualification-receipt.v1.json",
  "title": "Orchestration qualification receipt v1"
}
