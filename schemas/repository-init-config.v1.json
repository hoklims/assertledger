{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "repository": {
      "$ref": "#/$defs/__schema1"
    },
    "packageManager": {
      "$ref": "#/$defs/__schema3"
    },
    "framework": {
      "$ref": "#/$defs/__schema4"
    },
    "testCommand": {
      "$ref": "#/$defs/__schema5"
    },
    "adapter": {
      "$ref": "#/$defs/__schema7"
    },
    "candidateRoots": {
      "$ref": "#/$defs/__schema11"
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "packageManager",
    "framework",
    "testCommand",
    "adapter",
    "candidateRoots"
  ],
  "additionalProperties": false,
  "title": "AssertLedger repository init config",
  "description": "Portable static configuration produced by assertledger init.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "const": "."
        },
        "exclude": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": ["root", "exclude"],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema3": {
      "type": "string",
      "enum": ["pnpm", "npm", "yarn", "bun", "uv", "poetry", "pip"]
    },
    "__schema4": {
      "type": "string",
      "enum": ["node:test", "vitest", "jest", "bun:test", "pytest"]
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "arguments": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        }
      },
      "required": ["executable", "arguments"],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "maxLength": 1024
    },
    "__schema7": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "node-test"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "baseTestFiles": {
              "minItems": 1,
              "maxItems": 1000,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema8"
              }
            },
            "extraArguments": {
              "maxItems": 0,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema9"
              }
            }
          },
          "required": ["kind", "executable", "baseTestFiles"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "testforge-command"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema10"
              }
            },
            "protocolVersion": {
              "type": "string",
              "const": "1.0.0"
            }
          },
          "required": ["kind", "executable", "arguments", "protocolVersion"],
          "additionalProperties": false
        }
      ]
    },
    "__schema8": {
      "type": "string",
      "minLength": 1
    },
    "__schema9": {
      "type": "string"
    },
    "__schema10": {
      "type": "string"
    },
    "__schema11": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema12"
      }
    },
    "__schema12": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "$id": "https://testforge.dev/schemas/repository-init-config.v1.json"
}
