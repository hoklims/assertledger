{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "root": {
      "$ref": "#/$defs/__schema0"
    },
    "fileCount": {
      "$ref": "#/$defs/__schema1"
    },
    "files": {
      "$ref": "#/$defs/__schema2"
    },
    "languages": {
      "$ref": "#/$defs/__schema4"
    },
    "detectedTestFrameworks": {
      "$ref": "#/$defs/__schema5"
    },
    "repositoryDigest": {
      "$ref": "#/$defs/__schema6"
    },
    "capabilities": {
      "$ref": "#/$defs/__schema7"
    }
  },
  "required": [
    "root",
    "fileCount",
    "files",
    "languages",
    "detectedTestFrameworks",
    "repositoryDigest",
    "capabilities"
  ],
  "additionalProperties": false,
  "title": "TestForge repository analysis",
  "description": "A deterministic repository inventory and the execution capabilities exposed by TestForge.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "maxItems": 1000000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "__schema4": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": ["name", "files"],
        "additionalProperties": false
      }
    },
    "__schema5": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "__schema6": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "canExecuteCandidates": {
          "type": "boolean"
        },
        "supportedAdapters": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["node-test", "testforge-command"]
          }
        },
        "isolationLevels": {
          "type": "array",
          "items": {
            "type": "string",
            "const": "UNSANDBOXED"
          }
        }
      },
      "required": ["canExecuteCandidates", "supportedAdapters", "isolationLevels"],
      "additionalProperties": false
    }
  },
  "$id": "https://testforge.dev/schemas/repository-analysis.v1.json"
}
