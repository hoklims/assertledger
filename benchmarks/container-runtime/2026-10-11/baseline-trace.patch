+import { appendFile } from "node:fs/promises";
+const failedPaths = new Set();
+export async function traceOperation(phase, context, operation, facts) {
+    const destination = process.env.ASSERTLEDGER_RUNTIME_TRACE;
+    if (!destination)
+        return operation();
+    const startedAt = new Date().toISOString();
+    const start = performance.now();
+    let result;
+    let threw = true;
+    try {
+        result = await operation();
+        threw = false;
+        return result;
+    }
+    finally {
+        const event = {
+            phase,
+            container: null,
+            ...context,
+            startedAt,
+            durationMs: performance.now() - start,
+            threw,
+            ...facts?.(result),
+        };
+        try {
+            await appendFile(destination, `${JSON.stringify(event)}\n`, "utf8");
+        }
+        catch {
+            if (!failedPaths.has(destination)) {
+                failedPaths.add(destination);
+                process.stderr.write("ASSERTLEDGER_RUNTIME_TRACE_WRITE_FAILED\n");
+            }
+        }
+    }
+}
