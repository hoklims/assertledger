    {
      "id": "unbounded-edges",
      "description": "Computed, absolute, URL-like and outside-repository specifiers make a file unbounded, sorted by file then reason",
      "files": {
        "test.ts": "import(x);\nimport \"/abs.js\";\nimport \"file:///x.js\";\nimport \"c:/x.js\";\nimport \"../outside.js\";\nimport \"./sub/b.js\";\n",
        "sub/b.ts": "import \"../../up.js\";\nrequire(name);\n"
      },
      "roots": ["test.ts"],
      "closure": {
        "files": ["sub/b.ts", "test.ts"],
        "links": [],
        "unbounded": [
          {
            "file": "sub/b.ts",
            "reason": "MODULE_OUTSIDE_REPOSITORY"
          },
          {
            "file": "sub/b.ts",
            "reason": "NON_LITERAL_MODULE_SPECIFIER"
          },
          {
            "file": "test.ts",
            "reason": "ABSOLUTE_MODULE_SPECIFIER"
          },
          {
            "file": "test.ts",
            "reason": "MODULE_OUTSIDE_REPOSITORY"
          },
          {
            "file": "test.ts",
            "reason": "NON_LITERAL_MODULE_SPECIFIER"
          }
        ]
      }
