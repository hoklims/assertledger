    {
      "id": "link-stops-walk",
      "description": "Without a target map a link on the path is recorded and not walked",
      "files": {
        "test.ts": "import \"./linked/a.js\";\n",
        "real/a.ts": ""
      },
      "links": ["linked"],
      "roots": ["test.ts"],
      "closure": {
        "files": ["test.ts"],
        "links": ["linked"],
        "unbounded": []
      }
    },
    {
      "id": "link-followed",
      "description": "With a target map the link is recorded and its target walked",
      "files": {
        "test.ts": "import \"./linked/a.js\";\n",
        "real/a.ts": "import \"./b.js\";\n",
        "real/b.ts": ""
      },
      "links": ["linked"],
      "linkTargets": {
        "linked": "real"
